   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 02. Graph Construction\n",
    "\n",
    "This notebook demonstrates how to construct a NetworkX graph from the transaction data for analysis, and how to convert it to a PyTorch Geometric (PyG) `Data` object for machine learning."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import networkx as nx\n",
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "# Add project root to sys path\n",
    "sys.path.append(str(Path.cwd().parent))\n",
    "from src.data.loader import load_processed_data\n",
    "from src.graph.graph_builder import build_networkx_graph, build_pyg_graph"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "nodes_df, edges_df = load_processed_data()\n",
    "\n",
    "if nodes_df is not None:\n",
    "    print(\"Constructing NetworkX Graph...\")\n",
    "    # For demonstration, let's take a small subgraph (first 500 edges) to avoid freezing the notebook\n",
    "    small_edges = edges_df.head(500)\n",
    "    valid_nodes = set(small_edges['txId1']).union(set(small_edges['txId2']))\n",
    "    small_nodes = nodes_df[nodes_df['txId'].isin(valid_nodes)]\n",
    "    \n",
    "    G = build_networkx_graph(small_nodes, small_edges)\n",
    "    print(f\"Graph nodes: {G.number_of_nodes()}\")\n",
    "    print(f\"Graph edges: {G.number_of_edges()}\")\n",
    "else:\n",
    "    print(\"Processed data not found. Run preprocessing first.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if nodes_df is not None:\n",
    "    print(\"Constructing PyTorch Geometric Graph...\")\n",
    "    try:\n",
    "        pyg_data = build_pyg_graph(nodes_df, edges_df)\n",
    "        print(pyg_data)\n",
    "    except ImportError:\n",
    "        print(\"PyTorch Geometric not installed.\")"
   ]
  }

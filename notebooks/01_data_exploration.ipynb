    "# 01. Exploratory Data Analysis (EDA)\n",
    "\n",
    "In this notebook, we explore the raw blockchain transaction dataset (e.g., the Elliptic Bitcoin dataset) to understand its structure, distributions, and potential challenges for anomaly detection."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "# Add project root to sys path\n",
    "sys.path.append(str(Path.cwd().parent))\n",
    "from src.data.loader import load_raw_data, load_processed_data\n",
    "from src.utils import config"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "features_df, edges_df, classes_df = load_raw_data()\n",
    "\n",
    "if features_df is None:\n",
    "    print(\"Dataset not found. Please follow DATASET_SETUP.md.\")\n",
    "else:\n",
    "    print(f\"Nodes: {len(features_df)}\")\n",
    "    print(f\"Edges: {len(edges_df)}\")\n",
    "    print(f\"Classes: {len(classes_df)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if classes_df is not None:\n",
    "    # Note: 1 = Illicit, 2 = Licit, unknown = Unknown\n",
    "    class_counts = classes_df['class'].value_counts()\n",
    "    print(class_counts)\n",
    "    \n",
    "    class_counts.plot(kind='bar')\n",
    "    plt.title('Class Distribution (Raw)')\n",
    "    plt.show()"
   ]
  }
